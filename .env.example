# Base URL the browser calls. In dev, keep "/api/v1/" so the Vite proxy forwards to VITE_API_PROXY_TARGET (no CORS).
# On Netlify, netlify.toml forwards /api/v1/* to the API, so keep "/api/v1/" there too.
VITE_API_BASE_URL=/api/v1/
VITE_API_PROXY_TARGET=https://api.sync360.africa

# The live site's address (e.g. https://your-site.netlify.app). Join QR codes made while running on
# localhost point here instead, because a customer's phone can't open localhost. Optional.
VITE_PUBLIC_SITE_URL=
